# ─── Admin panel ──────────────────────────────────────────────────────────────
# Required for /admin. Without these the login route returns 503 rather than
# falling back to a default credential.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the session cookie (HMAC-SHA256). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=

# ─── Content storage (optional) ───────────────────────────────────────────────
# When set, /admin saves go to the `cms-content` bucket and are live within the
# 60s revalidate window. When unset the site still runs and still edits — saves
# are written to the repo's data/*.json instead, which is the right mode for
# local work. See lib/cms-section.ts.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Contact form (optional) ──────────────────────────────────────────────────
# Without these the form renders and validates but POST /api/contact returns 503.
RESEND_API_KEY=
# Where submissions are delivered. Intake question Q6 has not been answered, so
# confirm with the client which address should receive these.
CONTACT_TO_EMAIL=
# Must be on a domain verified with Resend. Do NOT put the visitor's address here
# — the route sets replyTo for that; a spoofed From fails SPF and lands in spam.
CONTACT_FROM_EMAIL=

# ─── Indexing ─────────────────────────────────────────────────────────────────
# Search engines are blocked unless this is "true" AND the sign-off in
# data/deliverables.json is complete. Both gates are required.
#
# The env flag is separate on purpose: sign-off is data the admin panel can flip,
# and a profile can be approved for print or LinkedIn long before anyone decides
# the site should rank. Nobody should be able to index this by ticking a checkbox.
#
# SET THIS IN THE DEPLOYMENT ENVIRONMENT, NOT ONLY HERE. This file is an example
# and is not loaded at runtime; on Vercel it is `vercel env add
# NEXT_PUBLIC_ALLOW_INDEXING production`. It is a NEXT_PUBLIC_ var, so it is
# inlined at BUILD time — changing it requires a redeploy, not just a restart.
#
# ⚠️ BEFORE SETTING THIS TRUE, CHECK data/siteSettings.json `siteUrl`. Canonical
# tags and the sitemap are both built from it. Indexing while it is still the
# placeholder publishes canonicals pointing at a domain that may not be yours,
# and a search engine keeps that long after the value is corrected.
NEXT_PUBLIC_ALLOW_INDEXING=true
